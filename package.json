{
  "name": "magpie-agent-proma",
  "version": "0.5.4",
  "description": "Magpie Agent plugin for Proma with continuously synchronized models on Windows",
  "type": "module",
  "files": [
    "agent.js",
    "server.js",
    "sync-engine.cjs",
    "native-channels.cjs",
    "native-proxy.cjs",
    "reasoning-capabilities.cjs",
    "capability-report.cjs",
    "magpie-proma.cjs",
    "README.md",
    "CHANGELOG.md",
    "install.ps1",
    "install.cmd",
    "uninstall.cmd",
    "check.cmd",
    "sync.cmd",
    "capability-rules.json",
    "compatibility.cjs",
    "runtime-options.cjs",
    "plugin-tools.cjs",
    "run-tool.ps1",
    "doctor.cmd",
    "restore.cmd",
    "icon.svg",
    "LICENSE",
    "docs",
    "PRIVACY.md",
    "index.js",
    "bridge.hooks.js",
    "bridge-service.cjs"
  ],
  "keywords": [
    "magpie-plugin",
    "magpie-agent",
    "proma",
    "opencode",
    "opencode-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "magpie": {
    "agent": "./agent.js",
    "icon": "data:image/svg+xml;base64,",
    "hooks": "./bridge.hooks.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node plugin-tools.cjs doctor",
    "capabilities": "node capability-report.cjs",
    "release": "node scripts/release.cjs",
    "test:magpie": "node smoke-magpie.cjs"
  },
  "license": "MIT",
  "author": "KirishimaRin",
  "repository": {
    "type": "git",
    "url": "https://github.com/KirishimaRin/magpie-agent-proma.git"
  },
